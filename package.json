{
  "name": "@askabd/identity-platform",
  "version": "0.1.0",
  "description": "AskABD Universal Identity Platform",
  "author": "AskABD Technologies <hello@askabd.com>",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "release:patch": "npm version patch -m \"release: v%s\"",
    "release:minor": "npm version minor -m \"release: v%s\"",
    "release:major": "npm version major -m \"release: v%s\"",
    "prebuild": "npm run clean",
    "pretest": "npm run typecheck"
  },
  "dependencies": {
    "fastify": "5.3.3",
    "@fastify/cors": "11.0.0",
    "@fastify/helmet": "13.0.1",
    "pino": "9.6.0",
    "dotenv": "16.5.0",
    "zod": "3.25.32"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "typescript": "5.8.3",
    "vitest": "3.2.1",
    "@vitest/coverage-v8": "3.2.1",
    "fast-check": "4.1.1",
    "tsx": "4.19.4",
    "eslint": "9.27.0",
    "@typescript-eslint/eslint-plugin": "8.33.0",
    "@typescript-eslint/parser": "8.33.0",
    "prettier": "3.5.3",
    "rimraf": "6.0.1"
  }
}
